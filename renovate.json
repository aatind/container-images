{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "onboarding": false,
  "dependencyDashboard": false,
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDepNames": ["nextcloud", "vaultwarden/server"],
      "labels": ["renovate", "base-image"],
      "automerge": false,
      "commitMessageTopic": "base image {{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Nextcloud base-image version pinned in the Dockerfile ARG and the build-script default",
      "fileMatch": [
        "^nextcloud-w-smb/Dockerfile$",
        "^nextcloud-w-smb/scripts/build-and-push\\.sh$"
      ],
      "matchStrings": [
        "ARG NEXTCLOUD_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "NEXTCLOUD_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "packageNameTemplate": "nextcloud",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Vaultwarden base-image version pinned in the Dockerfile ARG and the build-script default",
      "fileMatch": [
        "^vaultwarden-hardened/Dockerfile$",
        "^vaultwarden-hardened/scripts/build-and-push\\.sh$"
      ],
      "matchStrings": [
        "ARG VAULTWARDEN_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "VAULTWARDEN_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "packageNameTemplate": "vaultwarden/server",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "dockerfile": {
    "enabled": false
  }
}
